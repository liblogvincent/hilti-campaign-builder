DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_STYLE=openai
DEEPSEEK_TIMEOUT_MS=20000
PANDA_API_PORT=8787
PANDA_RUNTIME_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres pooler URL for migrations/admin jobs. Do not expose this to the browser.
SUPABASE_DB_URL=
PANDA_AI_TRANSPORT=vercel-ai
PANDA_DEFAULT_MODEL=deepseek-chat
FIGMA_TOKEN=
# Remote Figma MCP is the target for Vercel. It requires OAuth/session auth.
FIGMA_MCP_URL=https://mcp.figma.com/mcp
FIGMA_MCP_TOOL=generate_figma_design
# Prototype-only fallback if a bearer token/session is available server-side.
FIGMA_MCP_ACCESS_TOKEN=
# Optional static OAuth client. If omitted, Panda dynamically registers a Figma MCP OAuth client.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=
PANDA_PUBLIC_BASE_URL=
PANDA_APP_URL=
